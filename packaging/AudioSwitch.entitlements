<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime blocks microphone access unless it is requested
         here. Without this entitlement the input level meter silently receives
         nothing on a Developer ID signed build, even though the same code works
         when signed ad-hoc. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
